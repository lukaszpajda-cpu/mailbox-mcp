Options -Indexes
RewriteEngine On
# HTTPS redirect. Behind a TLS-terminating proxy that talks plain HTTP to
# this server, %{HTTPS} is never "on" and these two lines loop: remove
# them there and set security.trusted_proxies instead (docs/deployment.md).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteCond %{REQUEST_URI} !^/diag\.php$
RewriteRule ^ index.php [L]
# Only the two entry points are ever served; everything else here,
# including mailbox-mcp.paths.php, is denied.
<FilesMatch "^(?!index\.php$|diag\.php$).*$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
</IfModule>
